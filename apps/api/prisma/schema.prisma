generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FINISHED
}

enum EventMode {
  PHYSICAL
  ONLINE
  HYBRID
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
}

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AccountPlan {
  FREE
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum RegistrationFormStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum RegistrationSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MarketingConsentStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
  PENDING_CONFIRMATION
}

enum EmailTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TemplateChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationTiming {
  IMMEDIATE
  BEFORE_EVENT
  AFTER_EVENT
  AFTER_PREVIOUS_STEP
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

model AuthUser {
  id                     String               @id @default(uuid()) @db.Uuid
  email                  String               @unique
  passwordHash           String               @map("password_hash")
  role                   GlobalRole           @default(USER)
  plan                   AccountPlan          @default(FREE)
  isActive               Boolean              @default(true) @map("is_active")
  emailVerifiedAt        DateTime?            @map("email_verified_at")
  passwordResetTokenHash String?              @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime?            @map("password_reset_expires_at")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  profile                Profile?
  memberships            OrganizationMember[]

  @@map("auth_users")
}

model Profile {
  id                     String               @id @default(uuid()) @db.Uuid
  authUserId             String?              @unique @map("auth_user_id") @db.Uuid
  organizationId         String?              @map("organization_id") @db.Uuid
  firstName              String?              @map("first_name")
  lastName               String?              @map("last_name")
  phone                  String?
  avatarUrl              String?              @map("avatar_url")
  bio                    String?
  identityDocumentType   String?              @map("identity_document_type")
  identityDocumentNumber String?              @map("identity_document_number")
  birthDate              DateTime?            @map("birth_date")
  sex                    String?
  location               String?
  institution            String?
  dedication             String?
  researchInterests      String?              @map("research_interests")
  areasOfInterest        String[]             @default([]) @map("areas_of_interest")
  expertiseAreas         String[]             @default([]) @map("expertise_areas")
  socialLinks            Json?                @map("social_links")
  additionalEmails       Json?                @map("additional_emails")
  isPublic               Boolean              @default(false) @map("is_public")
  onboardingCompleted    Boolean              @default(false) @map("onboarding_completed")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  authUser               AuthUser?            @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  organization           Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships            OrganizationMember[]
  education              Education[]
  employment             EmploymentHistory[]
  certifications         Certification[]
  participants           EventParticipant[]
  sessionSpeakers        SessionSpeaker[]
  marketingContacts      MarketingContact[]

  @@map("profiles")
}

model Organization {
  id             String                    @id @default(uuid()) @db.Uuid
  name           String
  slug           String                    @unique
  description    String?
  logoUrl        String?                   @map("logo_url")
  coverUrl       String?                   @map("cover_url")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  isActive       Boolean                   @default(true) @map("is_active")
  members        OrganizationMember[]
  profiles       Profile[]
  branches       OrganizationBranch[]
  events         MainEvent[]
  subscription   OrganizationSubscription?
  emailTemplates EmailTemplate[]
  marketingContacts MarketingContact[]
  marketingSegments MarketingSegment[]
  marketingCampaigns MarketingCampaign[]
  automations MarketingAutomation[]
  emailDeliveries EmailDelivery[]
  marketingEnrollments MarketingEventEnrollment[]

  @@map("organizations")
}

model MarketingContact {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  profileId       String?                @map("profile_id") @db.Uuid
  emailFallback   String?                @map("email_fallback")
  consentStatus   MarketingConsentStatus @default(PENDING_CONFIRMATION) @map("consent_status")
  consentedAt     DateTime?              @map("consented_at")
  unsubscribedAt  DateTime?              @map("unsubscribed_at")
  source          String                 @default("MANUAL")
  tags            String[]               @default([])
  createdAt       DateTime               @default(now()) @map("created_at")
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile         Profile?               @relation(fields: [profileId], references: [id], onDelete: SetNull)
  segmentMembers  MarketingSegmentMember[]
  enrollments     MarketingEventEnrollment[]
  @@unique([organizationId, profileId])
  @@unique([organizationId, emailFallback])
  @@index([organizationId, emailFallback])
  @@map("marketing_contacts")
}

model MarketingSegment {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  name            String
  description     String?
  type            String                   @default("MANUAL")
  rules           Json?
  createdAt       DateTime                 @default(now()) @map("created_at")
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members         MarketingSegmentMember[]
  @@unique([organizationId, name])
  @@map("marketing_segments")
}

model MarketingSegmentMember {
  segmentId String @map("segment_id") @db.Uuid
  contactId String @map("contact_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at")
  segment MarketingSegment @relation(fields:[segmentId], references:[id], onDelete:Cascade)
  contact MarketingContact @relation(fields:[contactId], references:[id], onDelete:Cascade)
  @@id([segmentId, contactId])
  @@map("marketing_segment_members")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  profileId      String       @map("profile_id") @db.Uuid
  accountId      String?      @map("account_id") @db.Uuid
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account        AuthUser?    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, profileId])
  @@unique([organizationId, accountId])
  @@map("organization_members")
}

model OrganizationSubscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @map("organization_id") @db.Uuid
  plan           AccountPlan        @default(FREE)
  status         SubscriptionStatus @default(ACTIVE)
  startsAt       DateTime           @default(now()) @map("starts_at")
  renewsAt       DateTime?          @map("renews_at")
  endsAt         DateTime?          @map("ends_at")
  provider       String?
  providerRef    String?            @map("provider_ref")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_subscriptions")
}

model OrganizationBranch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  isMain         Boolean      @default(false) @map("is_main")
  department     String?
  province       String?
  district       String?
  address        String?
  reference      String?
  latitude       Float?
  longitude      Float?
  contactPhones  String[]     @default([]) @map("contact_phones")
  contactEmails  String[]     @default([]) @map("contact_emails")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_branches")
}

model MainEvent {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String?             @map("organization_id") @db.Uuid
  eventName      String              @map("event_name")
  description    String?
  status         EventStatus         @default(DRAFT)
  eventMode      EventMode?          @map("event_mode")
  startDate      DateTime            @map("start_date")
  endDate        DateTime?           @map("end_date")
  coverUrl       String?             @map("cover_url")
  logoUrl        String?             @map("logo_url")
  contactEmail   String?             @map("contact_email")
  venueAddress   String?             @map("venue_address")
  latitude       Float?
  longitude      Float?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  editions       Edition[]
  details        EventDetail?
  thematicLines  ThematicLine[]
  setupProgress  EventSetupProgress?
  contacts       EventContact[]
  registrationForms RegistrationForm[]
  automations MarketingAutomation[]
  marketingEnrollments MarketingEventEnrollment[]

  @@index([organizationId, status])
  @@map("main_events")
}

model EventSetupProgress {
  id                 String    @id @default(uuid()) @db.Uuid
  eventId            String    @unique @map("event_id") @db.Uuid
  basicInfoCompleted Boolean   @default(false) @map("basic_info_completed")
  rolesCompleted     Boolean   @default(false) @map("roles_completed")
  editionCompleted   Boolean   @default(false) @map("edition_completed")
  peopleCompleted    Boolean   @default(false) @map("people_completed")
  contactCompleted   Boolean   @default(false) @map("contact_completed")
  completed          Boolean   @default(false)
  currentStep        Int       @default(1) @map("current_step")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  event              MainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_setup_progress")
}

model EventContact {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  role      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  event     MainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([eventId])
  @@map("event_contacts")
}

model EventDetail {
  id          Int       @id @default(autoincrement())
  eventId     String    @unique @map("event_id") @db.Uuid
  content     String?
  socialLinks Json?     @map("social_links")
  media       Json?
  sponsors    Json?
  faqs        Json?
  event       MainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_details")
}

model Edition {
  id           String             @id @default(uuid()) @db.Uuid
  mainEventId  String             @map("main_event_id") @db.Uuid
  name         String
  startDate    DateTime?          @map("start_date")
  endDate      DateTime?          @map("end_date")
  modality     String?
  location     String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime           @default(now()) @map("created_at")
  mainEvent    MainEvent          @relation(fields: [mainEventId], references: [id], onDelete: Cascade)
  activities   EventActivity[]
  participants EventParticipant[]
  tickets      EventTicket[]
  registrationForms RegistrationForm[]

  @@index([mainEventId])
  @@map("editions")
}

model RegistrationForm {
  id                    String                     @id @default(uuid()) @db.Uuid
  mainEventId           String                     @map("main_event_id") @db.Uuid
  editionId             String?                    @map("edition_id") @db.Uuid
  title                 String
  description           String?
  slug                  String                     @unique
  status                RegistrationFormStatus     @default(DRAFT)
  opensAt               DateTime?                  @map("opens_at")
  closesAt              DateTime?                  @map("closes_at")
  maxSubmissions        Int?                       @map("max_submissions")
  approvalMode          String                     @default("MANUAL") @map("approval_mode")
  allowEditionSelection Boolean                    @default(false) @map("allow_edition_selection")
  defaultEditionId      String?                    @map("default_edition_id") @db.Uuid
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  mainEvent             MainEvent                  @relation(fields: [mainEventId], references: [id], onDelete: Cascade)
  edition               Edition?                   @relation(fields: [editionId], references: [id], onDelete: SetNull)
  fields                RegistrationFormField[]
  submissions           RegistrationSubmission[]
  @@index([mainEventId])
  @@map("registration_forms")
}

model RegistrationFormField {
  id          String           @id @default(uuid()) @db.Uuid
  formId      String           @map("form_id") @db.Uuid
  key         String
  label       String
  type        String
  required    Boolean          @default(false)
  options     Json?
  validation  Json?
  position    Int              @default(0)
  form        RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  @@unique([formId, key])
  @@map("registration_form_fields")
}

model RegistrationSubmission {
  id              String                     @id @default(uuid()) @db.Uuid
  formId          String                     @map("form_id") @db.Uuid
  editionId       String?                    @map("edition_id") @db.Uuid
  status          RegistrationSubmissionStatus @default(PENDING)
  email           String?
  answers         Json
  profileId       String?                    @map("profile_id") @db.Uuid
  participantId   String?                    @map("participant_id") @db.Uuid
  submittedAt     DateTime                   @default(now()) @map("submitted_at")
  reviewedAt      DateTime?                  @map("reviewed_at")
  form            RegistrationForm           @relation(fields: [formId], references: [id], onDelete: Cascade)
  marketingEnrollment MarketingEventEnrollment?
  @@index([formId, status])
  @@map("registration_submissions")
}

model EventActivity {
  id          String         @id @default(uuid()) @db.Uuid
  editionId   String         @map("event_id") @db.Uuid
  title       String
  description String?
  startsAt    DateTime?      @map("starts_at")
  endsAt      DateTime?      @map("ends_at")
  edition     Edition        @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sessions    EventSession[]

  @@map("event_activities")
}

model EventSession {
  id            String                @id @default(uuid()) @db.Uuid
  activityId    String                @map("activity_id") @db.Uuid
  title         String
  description   String?
  activity      EventActivity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  speakers      SessionSpeaker[]
  resources     SessionResource[]
  thematicLines SessionThematicLine[]

  @@map("event_sessions")
}

model SessionThematicLine {
  sessionId      String       @map("session_id") @db.Uuid
  thematicLineId String       @map("thematic_line_id") @db.Uuid
  session        EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  thematicLine   ThematicLine @relation(fields: [thematicLineId], references: [id], onDelete: Cascade)

  @@id([sessionId, thematicLineId])
  @@map("session_thematic_lines")
}

model SessionResource {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @map("session_id") @db.Uuid
  name      String
  url       String
  type      String?
  createdAt DateTime     @default(now()) @map("created_at")
  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_resources")
}

model SessionSpeaker {
  id        String       @id @default(uuid()) @db.Uuid
  sessionId String       @map("session_id") @db.Uuid
  profileId String       @map("profile_id") @db.Uuid
  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  profile   Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([sessionId, profileId])
  @@map("session_speakers")
}

model EventParticipant {
  id           String                   @id @default(uuid()) @db.Uuid
  editionId    String                   @map("edition_id") @db.Uuid
  profileId    String                   @map("profile_id") @db.Uuid
  roleId       String?                  @map("role_id") @db.Uuid
  registeredAt DateTime                 @default(now()) @map("registered_at")
  checkedIn    Boolean                  @default(false) @map("checked_in")
  edition      Edition                  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  profile      Profile                  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role         ParticipantRole?         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  certificates ParticipantCertificate[]

  @@unique([editionId, profileId])
  @@map("event_participants")
}

model ParticipantRole {
  id          String   @id @default(uuid()) @db.Uuid
  mainEventId String?  @map("main_event_id") @db.Uuid
  editionId   String?  @map("edition_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  participants EventParticipant[]

  @@index([mainEventId, editionId])
  @@unique([mainEventId, editionId, name])
  @@map("participant_roles")
}

model ThematicLine {
  id          String                @id @default(uuid()) @db.Uuid
  mainEventId String                @map("main_event_id") @db.Uuid
  editionId   String?               @map("edition_id") @db.Uuid
  name        String
  description String?
  event       MainEvent             @relation(fields: [mainEventId], references: [id], onDelete: Cascade)
  sessions    SessionThematicLine[]

  @@map("thematic_lines")
}

model EventTicket {
  id        String  @id @default(uuid()) @db.Uuid
  editionId String  @map("edition_id") @db.Uuid
  name      String
  price     Decimal @db.Decimal(10, 2)
  capacity  Int?
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@map("event_tickets")
}

model CertificateTemplate {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String
  design       Json?
  createdAt    DateTime                 @default(now()) @map("created_at")
  certificates ParticipantCertificate[]

  @@map("certificate_templates")
}

model ParticipantCertificate {
  id            String                   @id @default(uuid()) @db.Uuid
  participantId String                   @map("participant_id") @db.Uuid
  templateId    String?                  @map("template_id") @db.Uuid
  code          String                   @unique
  status        CertificateStatus        @default(ISSUED)
  issuedAt      DateTime                 @default(now()) @map("issued_at")
  participant   EventParticipant         @relation(fields: [participantId], references: [id], onDelete: Cascade)
  template      CertificateTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs          CertificateTrackingLog[]

  @@map("participant_certificates")
}

model CertificateTrackingLog {
  id            String                 @id @default(uuid()) @db.Uuid
  certificateId String                 @map("certificate_id") @db.Uuid
  action        String
  ipAddress     String?                @map("ip_address")
  createdAt     DateTime               @default(now()) @map("created_at")
  certificate   ParticipantCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@map("certificate_tracking_logs")
}

model Education {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  institution String
  degree      String?
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  profile     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("education")
}

model EmploymentHistory {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  company   String
  position  String?
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employment_history")
}

model Certification {
  id       String    @id @default(uuid()) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  name     String
  issuer   String?
  issuedAt DateTime? @map("issued_at")
  profile  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model EmailTemplate {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  name           String
  channel        TemplateChannel     @default(EMAIL)
  status         EmailTemplateStatus @default(DRAFT)
  subject        String?
  senderName     String?             @map("sender_name")
  senderEmail    String?             @map("sender_email")
  previewText    String?             @map("preview_text")
  content        Json?
  htmlContent    String?             @map("html_content") @db.Text
  category       String?             @default("CUSTOM")
  thumbnailUrl   String?             @map("thumbnail_url")
  tags           String[]            @default([])
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, channel, status])
  @@map("email_templates")
}

model MarketingAutomation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  eventId String? @map("event_id") @db.Uuid
  name String
  status AutomationStatus @default(DRAFT)
  settings Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  event MainEvent? @relation(fields:[eventId], references:[id], onDelete:SetNull)
  steps MarketingAutomationStep[]
  enrollments MarketingEventEnrollment[]
  @@index([organizationId, status])
  @@map("marketing_automations")
}

// Campañas puntuales: se conserva para envíos manuales y para no perder datos previos.
model MarketingCampaign {
  id String @id @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String
  subject String?
  status String @default("DRAFT")
  segmentIds Json @default("[]") @map("segment_ids")
  scheduledAt DateTime? @map("scheduled_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId, status])
  @@map("marketing_campaigns")
}

model MarketingEventEnrollment {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  eventId String @map("event_id") @db.Uuid
  automationId String @map("automation_id") @db.Uuid
  contactId String @map("contact_id") @db.Uuid
  submissionId String? @unique @map("submission_id") @db.Uuid
  firstName String? @map("first_name")
  registeredAt DateTime @default(now()) @map("registered_at")
  attendanceStatus String @default("REGISTERED") @map("attendance_status")
  purchaseStatus String @default("NONE") @map("purchase_status")
  benefitUsedAt DateTime? @map("benefit_used_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  event MainEvent @relation(fields:[eventId], references:[id], onDelete:Cascade)
  automation MarketingAutomation @relation(fields:[automationId], references:[id], onDelete:Cascade)
  contact MarketingContact @relation(fields:[contactId], references:[id], onDelete:Cascade)
  submission RegistrationSubmission? @relation(fields:[submissionId], references:[id], onDelete:SetNull)
  @@unique([automationId, contactId])
  @@index([eventId, attendanceStatus, purchaseStatus])
  @@map("marketing_event_enrollments")
}

model MarketingAutomationStep {
  id String @id @default(uuid()) @db.Uuid
  automationId String @map("automation_id") @db.Uuid
  position Int
  timing AutomationTiming
  offsetHours Int @default(0) @map("offset_hours")
  templateId String? @map("template_id") @db.Uuid
  subject String?
  htmlContent String? @map("html_content") @db.Text
  conditions Json?
  automation MarketingAutomation @relation(fields:[automationId], references:[id], onDelete:Cascade)
  @@unique([automationId, position])
  @@map("marketing_automation_steps")
}

model EmailDelivery {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  automationId String @map("automation_id") @db.Uuid
  stepId String @map("step_id") @db.Uuid
  contactId String? @map("contact_id") @db.Uuid
  recipientEmail String @map("recipient_email")
  recipientName String? @map("recipient_name")
  scheduledAt DateTime @map("scheduled_at")
  sentAt DateTime? @map("sent_at")
