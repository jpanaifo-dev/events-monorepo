generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FINISHED
}
enum EventMode {
  PHYSICAL
  ONLINE
  HYBRID
}
enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
}
enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  USER
}
enum CertificateStatus {
  ISSUED
  REVOKED
}

model AuthUser {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            GlobalRole @default(USER)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  profile         Profile?
  @@map("auth_users")
}

model Profile {
  id          String    @id @db.Uuid
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  phone       String?
  avatarUrl   String?   @map("avatar_url")
  bio         String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  authUser    AuthUser  @relation(fields: [id], references: [id], onDelete: Cascade)
  memberships OrganizationMember[]
  education   Education[]
  employment  EmploymentHistory[]
  certifications Certification[]
  participants EventParticipant[]
  sessionSpeakers SessionSpeaker[]
  @@map("profiles")
}

model Organization {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?   @map("logo_url")
  coverUrl    String?   @map("cover_url")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  isActive    Boolean   @default(true) @map("is_active")
  members     OrganizationMember[]
  branches    OrganizationBranch[]
  events      MainEvent[]
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  profileId      String       @map("profile_id") @db.Uuid
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([organizationId, profileId])
  @@map("organization_members")
}

model OrganizationBranch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  isMain         Boolean      @default(false) @map("is_main")
  department     String?
  province       String?
  district       String?
  address        String?
  reference      String?
  latitude       Float?
  longitude      Float?
  contactPhones  String[]     @default([]) @map("contact_phones")
  contactEmails  String[]     @default([]) @map("contact_emails")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@map("organization_branches")
}

model MainEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  eventName      String       @map("event_name")
  description    String?
  status         EventStatus  @default(DRAFT)
  eventMode      EventMode?   @map("event_mode")
  startDate      DateTime     @map("start_date")
  endDate        DateTime?    @map("end_date")
  coverUrl       String?      @map("cover_url")
  logoUrl        String?      @map("logo_url")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  editions       Edition[]
  details        EventDetail?
  thematicLines  ThematicLine[]
  @@index([organizationId, status])
  @@map("main_events")
}

model EventDetail {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique @map("event_id") @db.Uuid
  content   String?
  socialLinks Json?  @map("social_links")
  media     Json?
  sponsors  Json?
  faqs      Json?
  event     MainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@map("event_details")
}

model Edition {
  id        String   @id @default(uuid()) @db.Uuid
  mainEventId String @map("main_event_id") @db.Uuid
  name      String
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  mainEvent MainEvent @relation(fields: [mainEventId], references: [id], onDelete: Cascade)
  activities EventActivity[]
  participants EventParticipant[]
  tickets EventTicket[]
  @@index([mainEventId])
  @@map("editions")
}

model EventActivity {
  id        String   @id @default(uuid()) @db.Uuid
  editionId String   @map("event_id") @db.Uuid
  title     String
  description String?
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sessions  EventSession[]
  @@map("event_activities")
}

model EventSession {
  id         String @id @default(uuid()) @db.Uuid
  activityId String @map("activity_id") @db.Uuid
  title      String
  description String?
  activity   EventActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  speakers   SessionSpeaker[]
  resources  SessionResource[]
  thematicLines SessionThematicLine[]
  @@map("event_sessions")
}

model SessionThematicLine {
  sessionId String @map("session_id") @db.Uuid
  thematicLineId String @map("thematic_line_id") @db.Uuid
  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  thematicLine ThematicLine @relation(fields: [thematicLineId], references: [id], onDelete: Cascade)
  @@id([sessionId, thematicLineId])
  @@map("session_thematic_lines")
}

model SessionResource {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  name      String
  url       String
  type      String?
  createdAt DateTime @default(now()) @map("created_at")
  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@map("session_resources")
}

model SessionSpeaker {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([sessionId, profileId])
  @@map("session_speakers")
}

model EventParticipant {
  id        String @id @default(uuid()) @db.Uuid
  editionId String @map("edition_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  registeredAt DateTime @default(now()) @map("registered_at")
  checkedIn Boolean @default(false) @map("checked_in")
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  certificates ParticipantCertificate[]
  @@unique([editionId, profileId])
  @@map("event_participants")
}

model ParticipantRole {
  id        String @id @default(uuid()) @db.Uuid
  mainEventId String? @map("main_event_id") @db.Uuid
  editionId String? @map("edition_id") @db.Uuid
  name      String @unique
  createdAt DateTime @default(now()) @map("created_at")
  @@index([mainEventId, editionId])
  @@map("participant_roles")
}

model ThematicLine {
  id          String @id @default(uuid()) @db.Uuid
  mainEventId String @map("main_event_id") @db.Uuid
  editionId   String? @map("edition_id") @db.Uuid
  name        String
  description String?
  event       MainEvent @relation(fields: [mainEventId], references: [id], onDelete: Cascade)
  sessions    SessionThematicLine[]
  @@map("thematic_lines")
}

model EventTicket {
  id        String @id @default(uuid()) @db.Uuid
  editionId String @map("edition_id") @db.Uuid
  name      String
  price     Decimal @db.Decimal(10, 2)
  capacity  Int?
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  @@map("event_tickets")
}

model CertificateTemplate {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  design    Json?
  createdAt DateTime @default(now()) @map("created_at")
  certificates ParticipantCertificate[]
  @@map("certificate_templates")
}

model ParticipantCertificate {
  id           String @id @default(uuid()) @db.Uuid
  participantId String @map("participant_id") @db.Uuid
  templateId   String? @map("template_id") @db.Uuid
  code         String @unique
  status       CertificateStatus @default(ISSUED)
  issuedAt     DateTime @default(now()) @map("issued_at")
  participant  EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  template     CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs         CertificateTrackingLog[]
  @@map("participant_certificates")
}

model CertificateTrackingLog {
  id            String @id @default(uuid()) @db.Uuid
  certificateId String @map("certificate_id") @db.Uuid
  action        String
  ipAddress     String? @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")
  certificate   ParticipantCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  @@map("certificate_tracking_logs")
}

model Education {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  institution String
  degree String?
  startDate DateTime? @map("start_date")
  endDate DateTime? @map("end_date")
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("education")
}

model EmploymentHistory {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  company String
  position String?
  startDate DateTime? @map("start_date")
  endDate DateTime? @map("end_date")
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("employment_history")
}

model Certification {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  name String
  issuer String?
  issuedAt DateTime? @map("issued_at")
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("certifications")
}
