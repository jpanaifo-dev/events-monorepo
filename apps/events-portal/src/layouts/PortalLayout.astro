---
import type { PortalOrganization } from '../lib/api';
const { organization, title } = Astro.props as { organization: PortalOrganization; title: string };
const brand = organization.name.slice(0, 1).toUpperCase();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={organization.description || `Eventos de ${organization.name}`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href={`/${organization.slug}`} class="brand" aria-label={organization.name}>
        {organization.logoUrl ? <img src={organization.logoUrl} alt={`Logo de ${organization.name}`} /> : <span class="brand-mark">{brand}</span>}
        <span>{organization.name}</span>
      </a>
      <a href="#eventos" class="nav-link">Eventos</a>
    </header>
    <main><slot /></main>
    <footer>Portal de eventos · {organization.name}</footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; color: #172033; background: #fbfcfe; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .site-header { height: 68px; display: flex; align-items: center; justify-content: space-between; padding: 0 6vw; border-bottom: 1px solid #e7eaf0; background: rgba(255,255,255,.92); }
  .brand { display: flex; align-items: center; gap: .7rem; color: inherit; font-size: .95rem; text-decoration: none; }
  .brand img, .brand-mark { width: 32px; height: 32px; border-radius: 8px; object-fit: cover; }
  .brand-mark { display: grid; place-items: center; background: #eff3f9; color: #284e81; }
  .nav-link { color: #40536e; font-size: .9rem; text-decoration: none; }
  footer { padding: 2rem 6vw; color: #6a7689; font-size: .82rem; border-top: 1px solid #e7eaf0; }
</style>
