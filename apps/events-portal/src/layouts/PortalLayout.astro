---
import type { PortalOrganization } from '../lib/api';

interface Props {
  organization: PortalOrganization;
  title: string;
  venues?: string[];
}

const { organization, title, venues = [] } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={organization.description || `Eventos y conferencias oficiales de ${organization.name}`} />
    <title>{title}</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="tdc-body">
    <!-- TDC / Stripe Sessions Minimalist Cinematic Header -->
    <header class="tdc-header">
      <div class="tdc-container header-content">
      <div class="header-left">
        <!-- Minimalist Circular Menu Icon -->
        <a href={`/${organization.slug}#eventos`} class="tdc-icon-btn" title="Menú de eventos">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <line x1="4" x2="20" y1="12" y2="12"/>
            <line x1="4" x2="20" y1="6" y2="6"/>
            <line x1="4" x2="20" y1="18" y2="18"/>
          </svg>
        </a>

        <!-- Organization Brand -->
        <a href={`/${organization.slug}`} class="tdc-brand-link">
          {organization.logoUrl ? (
            <img src={organization.logoUrl} alt={organization.name} class="tdc-logo" />
          ) : (
            <span class="tdc-brand-text">{organization.name}</span>
          )}
        </a>
      </div>

      <!-- Center / Right Meta: Local Time & Action Pills -->
      <div class="header-right">
        <!-- Live Clock Indicator -->
        <div class="tdc-time-pill" id="live-clock">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          <span id="time-display">PET</span>
        </div>

        <a href={`/${organization.slug}#eventos`} class="tdc-pill-btn secondary">
          <span>Explorar</span>
        </a>

        <a href={`/${organization.slug}#eventos`} class="tdc-pill-btn primary">
          <span>Asistir</span>
        </a>

        <a href={`/${organization.slug}#eventos`} class="tdc-icon-btn action" title="Ir a eventos">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/>
            <path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
        <button type="button" class="tdc-icon-btn theme-toggle" id="theme-toggle" aria-label="Cambiar tema" title="Cambiar tema">
          <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </button>
      </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- TDC Cinematic Dark Footer -->
    <footer class="tdc-footer">
      <div class="tdc-container">
        <div class="footer-grid">
          <div class="footer-brand-pane">
            <span class="footer-org-name">{organization.name.toUpperCase()}</span>
            <p class="footer-desc">
              {organization.description || 'Portal oficial de experiencias, conferencias magistrales, congresos y talleres.'}
            </p>
          </div>

          <div class="footer-nav-pane">
            <h4>Navegación</h4>
            <ul>
              <li><a href={`/${organization.slug}#eventos`}>Eventos publicados</a></li>
              <li><a href={`/${organization.slug}#destacado`}>Experiencia destacada</a></li>
              <li><a href={`/${organization.slug}#workshops`}>Talleres y sesiones</a></li>
            </ul>
          </div>

          <div class="footer-meta-pane">
            <h4>Portal Institucional</h4>
            <span class="portal-badge">ID: {organization.slug}</span>
            <p class="portal-note">Consumiendo información en vivo y sincronizada de eventos publicados.</p>
          </div>
        </div>

        <div class="footer-bar">
          <p>© {new Date().getFullYear()} {organization.name}. Todos los derechos reservados.</p>
          <div class="footer-bar-links">
            <a href={`/${organization.slug}#eventos`}>Eventos</a>
            <span>·</span>
            <a href={`/${organization.slug}`}>Inicio</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const savedTheme = localStorage.getItem('events-portal-theme');
      const preferredTheme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      root.classList.toggle('dark', preferredTheme === 'dark');
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = root.classList.contains('dark') ? 'light' : 'dark';
        root.classList.toggle('dark', next === 'dark');
        localStorage.setItem('events-portal-theme', next);
      });
      // Live clock script
      function updateClock() {
        const display = document.getElementById('time-display');
        if (display) {
          const now = new Date();
          display.textContent = now.toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' }) + ' PET';
        }
      }
      updateClock();
      setInterval(updateClock, 10000);
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  :global(html) {
    scroll-behavior: smooth;
    background-color: #f7f9fc;
  }
  :global(body) {
    margin: 0;
    color: #172033;
    background-color: #f7f9fc;
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  :global(html.dark) { background-color: #0c0e12; color-scheme: dark; }
  :global(html.dark body) { color: #f1f5f9; background-color: #0c0e12; }
  :global(.tdc-container) {
    width: min(100% - 2rem, 1320px);
    margin-inline: auto;
  }

  /* ---------------------------------------------------- */
  /* HEADER                                               */
  /* ---------------------------------------------------- */
  .tdc-header {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 4vw;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid #e4e9f0;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  :global(html.dark) .tdc-header { background: rgba(12, 14, 18, 0.85); border-bottom-color: rgba(255, 255, 255, 0.08); }
  .header-content { height: 100%; display: flex; align-items: center; justify-content: space-between; }

  .header-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .tdc-icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #f2f5f9;
    border: 1px solid #dfe6ef;
    color: #20314a;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  :global(html.dark) .tdc-icon-btn { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.12); color: #ffffff; }
  .tdc-icon-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.25);
    transform: scale(1.05);
  }
  .tdc-icon-btn.action {
    background: #ffffff;
    color: #000000;
    border: none;
  }
  .tdc-icon-btn.action:hover {
    background: #e2e8f0;
    transform: scale(1.05);
  }

  .tdc-brand-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #172033;
  }
  :global(html.dark) .tdc-brand-link { color: #ffffff; }
  .tdc-logo {
    height: 28px;
    max-width: 180px;
    object-fit: contain;
  }
  .tdc-brand-text {
    font-family: 'Outfit', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tdc-time-pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #53657e;
    padding: 0.45rem 0.85rem;
    background: #f7f9fc;
    border-radius: 9999px;
    border: 1px solid #e1e7ef;
  }
  :global(html.dark) .tdc-time-pill { color: rgba(255,255,255,.7); background: rgba(255,255,255,.04); border-color: rgba(255,255,255,.08); }

  .tdc-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .tdc-pill-btn.secondary {
    background: #f2f5f9;
    color: #243752;
    border: 1px solid #dfe6ef;
  }
  :global(html.dark) .tdc-pill-btn.secondary { background: rgba(255,255,255,.1); color: #fff; border-color: rgba(255,255,255,.12); }
  .tdc-pill-btn.secondary:hover {
    background: rgba(255, 255, 255, 0.18);
  }
  .tdc-pill-btn.primary {
    background: #ffffff;
    color: #000000;
  }
  .tdc-pill-btn.primary:hover {
    background: #e2e8f0;
    transform: translateY(-1px);
  }

  @media (max-width: 680px) {
    .tdc-time-pill, .tdc-pill-btn.secondary {
      display: none;
    }
  }

  /* ---------------------------------------------------- */
  /* FOOTER                                               */
  /* ---------------------------------------------------- */
  .tdc-footer {
    background: #edf2f7;
    border-top: 1px solid #dfe6ef;
    padding: 5rem 0 3rem;
  }
  :global(html.dark) .tdc-footer { background: #080a0d; border-top-color: rgba(255,255,255,.08); }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr;
    gap: 4rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-org-name {
    font-family: 'Outfit', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #ffffff;
    display: block;
    margin-bottom: 1rem;
  }
  .footer-desc {
    color: #94a3b8;
    font-size: 0.88rem;
    line-height: 1.65;
    max-width: 380px;
  }
  .footer-nav-pane h4, .footer-meta-pane h4 {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1.25rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .footer-nav-pane ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .footer-nav-pane a {
    color: #94a3b8;
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-nav-pane a:hover {
    color: #ffffff;
  }
  .portal-badge {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    color: #a5b4fc;
    font-family: monospace;
    font-size: 0.82rem;
    border-radius: 6px;
    margin-bottom: 0.75rem;
  }
  .portal-note {
    font-size: 0.82rem;
    color: #64748b;
    line-height: 1.5;
  }
  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    font-size: 0.82rem;
    color: #64748b;
  }
  .footer-bar-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .footer-bar-links a {
    color: #94a3b8;
    text-decoration: none;
  }
  .footer-bar-links a:hover {
    color: #ffffff;
  }
  :global(html:not(.dark)) .footer-grid { border-bottom-color: #d8e0ea; }
  :global(html:not(.dark)) .footer-org-name,
  :global(html:not(.dark)) .footer-nav-pane h4,
  :global(html:not(.dark)) .footer-meta-pane h4 { color: #23344d; }
  :global(html:not(.dark)) .footer-desc,
  :global(html:not(.dark)) .footer-nav-pane a,
  :global(html:not(.dark)) .footer-bar,
  :global(html:not(.dark)) .footer-bar-links a { color: #586a82; }
  :global(html:not(.dark)) .footer-nav-pane a:hover,
  :global(html:not(.dark)) .footer-bar-links a:hover { color: #1e4d82; }

  @media (max-width: 850px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
