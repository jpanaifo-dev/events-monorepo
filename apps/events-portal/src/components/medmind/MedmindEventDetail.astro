---
import { CalendarDays, ChevronRight, Clock3, Video } from '@lucide/astro';

interface Props {
  institution: string;
  event: any;
  edition: any;
  speakers: any[];
  activities: any[];
  form: any;
  heroImage: string;
  heroVideo?: string;
  apiUrl: string;
}

const { institution, event, edition, speakers, activities, form, heroImage, heroVideo, apiUrl } = Astro.props;
const startDate = edition?.startDate || event.startDate;
const date = startDate ? new Date(startDate) : null;
const dateLabel = date?.toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric' }) || 'Próximamente';
const timeLabel = date?.toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' }) || 'Hora por confirmar';
const description = edition?.description || event.details?.content || event.description || 'Una experiencia creada para ayudarte a avanzar con claridad.';
const modality = (edition?.modality || event.eventMode || 'VIRTUAL').replace('_', ' ');
const uniqueSpeakers = Array.from(new Map(speakers.map((speaker) => [speaker.id, speaker])).values());
const titleWords = String(event.eventName || '').trim().split(/\s+/).filter(Boolean);
const normalTitle = titleWords.length > 5 ? titleWords.slice(0, -5).join(' ') : '';
const coloredTitle = titleWords.length > 5 ? titleWords.slice(-5).join(' ') : titleWords.join(' ');
---

<article class="medmind-detail">
  <header class="medmind-nav">
    <a class="medmind-brand" href={`/${institution}`} aria-label="Volver al inicio de MedMind">
      <img src="/medmind/logo_medmind.svg" alt="MedMind" />
      <span>Webinar</span>
    </a>
    <nav aria-label="Navegación del webinar">
      {uniqueSpeakers.length > 0 && <a href="#ponentes">Expositores</a>}
      {activities.length > 0 && <a href="#agenda">Temario</a>}
    </nav>
    {form && <a class="nav-cta" href="#registro">Reservar cupo <ChevronRight size={16} aria-hidden="true" /></a>}
  </header>

  <section class="medmind-hero">
    <div class="hero-grid"></div>
    <div class="hero-glow one"></div><div class="hero-glow two"></div>
    <div class="medmind-wrap hero-content">
      <div class="hero-copy">
        <p class="eyebrow"><i></i>{modality} · {form ? 'CUPO GRATUITO' : 'PRÓXIMAMENTE'}</p>
        <h1>{normalTitle && <>{normalTitle} </>}<span class="hero-title-accent">{coloredTitle}</span></h1>
        <p class="hero-description">{description}</p>
        <div class="event-facts">
          <div><CalendarDays class="fact-icon" size={18} strokeWidth={1.8} aria-hidden="true" /><p><span>Fecha</span><strong>{dateLabel}</strong></p></div>
          <div><Clock3 class="fact-icon" size={18} strokeWidth={1.8} aria-hidden="true" /><p><span>Inicio</span><strong>{timeLabel}</strong></p></div>
          <div><Video class="fact-icon" size={18} strokeWidth={1.8} aria-hidden="true" /><p><span>Modalidad</span><strong>{modality}</strong></p></div>
        </div>
        <div class="hero-actions">
          {form ? <a class="primary-action" href="#registro">Quiero mi cupo gratis <ChevronRight size={17} aria-hidden="true" /></a> : <a class="secondary-action" href="#agenda">Conocer más</a>}
          {activities.length > 0 && <a class="secondary-action" href="#agenda">Explorar temario</a>}
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        {heroVideo ? <video autoplay muted loop playsinline poster={heroImage}><source src={heroVideo} /></video> : <img src={heroImage} alt="" />}
      </div>
    </div>
  </section>

  {date && <section class="countdown-banner" data-countdown-date={date.toISOString()} hidden><div class="medmind-wrap"><span class="countdown-label">FALTA POCO</span><p data-countdown-message>Reserva tu lugar antes de que inicie.</p><div class="countdown-values"><b data-days>00</b><i>d</i><b data-hours>00</b><i>h</i><b data-minutes>00</b><i>m</i><b data-seconds>00</b><i>s</i></div></div></section>}

  {uniqueSpeakers.length > 0 && <section id="ponentes" class="medmind-section speakers-section">
    <div class="medmind-wrap">
      <p class="section-kicker">EXPOSITORES</p>
      <h2>¿QUIÉNES TE ACOMPAÑARÁN?</h2>
      <p class="section-intro">Personas con experiencia para compartirte ideas claras y resolver tus dudas en vivo.</p>
      <div class="speakers-list">
        {uniqueSpeakers.map((speaker) => {
          const name = [speaker.firstName, speaker.lastName].filter(Boolean).join(' ') || 'Ponente invitado';
          return <article class="speaker-card">
            <div class="speaker-copy"><h3>{name}</h3><p class="speaker-role">EXPOSITOR/A · MEDMIND</p>{speaker.bio && <p>{speaker.bio}</p>}</div>
            <div class="speaker-photo">{speaker.avatarUrl ? <img src={speaker.avatarUrl} alt={name} /> : <span>{name.split(' ').map((word) => word[0]).join('').slice(0, 2)}</span>}</div>
          </article>
        })}
      </div>
    </div>
  </section>}

  {activities.length > 0 && <section id="agenda" class="medmind-section agenda-section">
    <div class="medmind-wrap">
      <p class="section-kicker">AGENDA</p>
      <h2>LO QUE VAS A DESCUBRIR</h2>
      <p class="section-intro">Contenido pensado para que termines con un plan claro.</p>
      <div class="agenda-grid">
        {activities.map((activity, index) => <article class="agenda-card"><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{activity.title}</h3>{activity.description && <p>{activity.description}</p>}{activity.startsAt && <small>{new Date(activity.startsAt).toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit' })}</small>}</div></article>)}
      </div>
    </div>
  </section>}

  {form && <section id="registro" class="registration-section">
    <div class="medmind-wrap registration-wrap">
      <div class="registration-heading"><p class="section-kicker">RESERVA TU CUPO</p><h2>INSCRÍBETE AL WEBINAR</h2><p>{form.description || 'Completa tus datos y recibe la información de acceso en tu correo.'}</p></div>
      <form id="medmind-registration" data-api={apiUrl} data-slug={form.slug} class="medmind-form">
        <div class="form-grid"><label>Nombres<input name="first_name" required autocomplete="given-name" /></label><label>Apellidos<input name="last_name" required autocomplete="family-name" /></label></div>
        <label>Correo electrónico<input name="email" type="email" required autocomplete="email" /></label>
        <button type="submit">Reservar mi cupo gratis <ChevronRight size={18} aria-hidden="true" /></button><p class="form-status" role="status"></p>
      </form>
      <div id="medmind-success" hidden><h3>¡Gracias por inscribirte!</h3><p>Revisa tu correo para conocer los siguientes pasos.</p><a href={`/${institution}/events/${event.id}`}>Volver al detalle</a></div>
    </div>
  </section>}

  <footer class="medmind-footer"><div class="medmind-wrap"><img src="/medmind/logo_medmind.svg" alt="MedMind" /><p>{event.eventName} · {dateLabel}</p><a href={`/${institution}`}>Ver más actividades</a></div></footer>
</article>

<script>
  const form = document.querySelector('#medmind-registration') as HTMLFormElement | null;
  const status = document.querySelector('.form-status') as HTMLElement | null;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = form.querySelector('button') as HTMLButtonElement;
    const values = Object.fromEntries(new FormData(form).entries());
    button.disabled = true; status!.textContent = 'Registrando tu cupo…';
    try {
      const response = await fetch(`${form.dataset.api}/public/registration-forms/${form.dataset.slug}/submissions`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ answers: values }) });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.message || 'No se pudo completar la inscripción.');
      form.hidden = true; document.querySelector<HTMLElement>('#medmind-success')?.removeAttribute('hidden');
    } catch (error: any) { status!.textContent = error.message || 'Ocurrió un error. Inténtalo de nuevo.'; } finally { button.disabled = false; }
  });
  document.querySelectorAll<HTMLElement>('[data-countdown-date]').forEach((banner) => {
    const target = new Date(banner.dataset.countdownDate || '').getTime();
    const message = banner.querySelector<HTMLElement>('[data-countdown-message]');
    const values = ['days', 'hours', 'minutes', 'seconds'].map((key) => banner.querySelector<HTMLElement>(`[data-${key}]`));
    const tick = () => {
      const distance = target - Date.now();
      const sameDay = new Date(target).toDateString() === new Date().toDateString();
      if (distance < 0) { if (sameDay) { banner.hidden = false; if (message) message.textContent = 'Este evento está en curso.'; values.forEach((node) => { if (node) node.textContent = '—'; }); } else banner.hidden = true; return; }
      banner.hidden = false;
      const total = Math.floor(distance / 1000);
      const parts = [Math.floor(total / 86400), Math.floor(total % 86400 / 3600), Math.floor(total % 3600 / 60), total % 60];
      values.forEach((node, index) => { if (node) node.textContent = String(parts[index]).padStart(2, '0'); });
    };
    tick(); window.setInterval(tick, 1000);
  });
</script>

<style>
  .medmind-detail { color:#172033; background:#fbfdfd; min-height:100vh; font-family:Inter,system-ui,sans-serif; padding-top:76px; }
  .event-facts div{display:flex;align-items:center;gap:.55rem}.event-facts p{margin:0}.fact-icon{color:#00a98f;flex:none}.countdown-banner{background:#102a28;color:#fff;padding:1.6rem 0}.countdown-banner .medmind-wrap{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;flex-wrap:wrap}.countdown-label{font-size:.78rem;letter-spacing:.14em;color:#83e4d3;font-weight:600}.countdown-banner p{margin:0;font-size:1.1rem}.countdown-values{display:flex;align-items:baseline;gap:.32rem}.countdown-values b{font-size:2rem;font-variant-numeric:tabular-nums;line-height:1}.countdown-values i{font-size:.78rem;color:#9ac2bb;font-style:normal;margin-right:.5rem}
  .medmind-wrap { width:100%; margin-inline:auto; padding-inline:clamp(1.25rem, 4vw, 4.5rem); box-sizing:border-box; } .medmind-nav { height:76px; display:flex; align-items:center; justify-content:space-between; padding:0 clamp(1.25rem, 4vw, 4.5rem); position:fixed; inset:0 0 auto; width:100%; box-sizing:border-box; z-index:30; border-bottom:1px solid #dfe9e8; background:rgba(251,253,253,.96); } .medmind-brand { display:flex; align-items:center; gap:.7rem; text-decoration:none; color:#172033; font-size:.75rem; text-transform:uppercase; letter-spacing:.12em; font-weight:600; } .medmind-brand img,.medmind-footer img { width:112px; height:34px; object-fit:contain; } .medmind-nav nav { display:flex; gap:1.7rem; } .medmind-nav nav a { color:#52615f; font-size:.86rem; text-decoration:none; } .nav-cta,.primary-action { background:#00a98f; color:white; border-radius:999px; padding:.75rem 1.1rem; text-decoration:none; font-size:.86rem; font-weight:600; display:inline-flex; align-items:center; gap:.25rem; } .medmind-hero { overflow:hidden; position:relative; padding:6.7rem 0 5rem; border-bottom:1px solid #dfe9e8; } .hero-grid { position:absolute; inset:0; background-image:radial-gradient(#00a98f 1px,transparent 1px); background-size:28px 28px; opacity:.08; } .hero-glow { position:absolute; border-radius:50%; filter:blur(100px); pointer-events:none; } .hero-glow.one { width:420px;height:420px;background:#00b49d2b;top:-160px;left:15%; }.hero-glow.two{width:330px;height:330px;background:#0ba2c722;right:6%;bottom:-160px}.hero-content{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;position:relative}.eyebrow,.section-kicker{font-size:.72rem;letter-spacing:.16em;font-weight:600;color:#008c86;margin:0 0 1rem}.eyebrow i{display:inline-block;width:8px;height:8px;border-radius:50%;background:#ee5555;margin-right:.55rem}.hero-copy h1,.medmind-section h2,.registration-heading h2{font-size:clamp(2.4rem,5vw,4.9rem);line-height:1.02;letter-spacing:-.055em;margin:0}.hero-copy h1{font-size:clamp(2.15rem,4.25vw,4.25rem);color:#172033}.hero-title-accent{color:#00a98f}.hero-description{font-size:1.05rem;color:#52615f;line-height:1.7;margin:1.5rem 0}.event-facts{display:flex;flex-wrap:wrap;gap:.65rem;margin:2rem 0}.event-facts div{border:1px solid #d8e5e3;background:#fff;padding:.75rem 1rem;border-radius:12px;min-width:145px}.event-facts span{display:block;color:#70807d;font-size:.7rem}.event-facts strong{font-size:.85rem;font-weight:600}.hero-actions{display:flex;gap:.7rem;flex-wrap:wrap}.primary-action,.secondary-action{padding:.9rem 1.2rem}.secondary-action{border:1px solid #cfdedb;border-radius:999px;color:#253431;text-decoration:none;font-size:.86rem}.hero-art{min-height:480px;position:relative}.hero-art img,.hero-art video{width:100%;height:100%;object-fit:contain;position:absolute;inset:0}.medmind-section{padding:6rem 0;border-bottom:1px solid #dfe9e8}.section-intro{max-width:640px;color:#667673;line-height:1.65;margin:1rem 0 3rem}.speakers-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.speaker-card{display:flex;justify-content:space-between;gap:1.5rem;padding:1.5rem;border:1px solid #dbe8e5;border-radius:20px;background:#fff}.speaker-copy h3,.agenda-card h3{margin:0;font-size:1.3rem}.speaker-copy p{color:#60706d;line-height:1.55}.speaker-role{font-size:.72rem;color:#009c91!important;letter-spacing:.1em;font-weight:600}.speaker-photo{height:104px;width:104px;flex:0 0 104px;overflow:hidden;border-radius:18px;background:#dff3ef;color:#008c86;display:grid;place-items:center;font-weight:600}.speaker-photo img{width:100%;height:100%;object-fit:cover}.agenda-section{background:#f4fbfa}.agenda-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.agenda-card{display:flex;gap:1rem;padding:1.5rem;border:1px solid #cfe7e3;border-radius:18px;background:#fff}.agenda-card>span{color:#008c86;font-weight:600;font-size:1.1rem}.agenda-card p{color:#63736f;line-height:1.55;margin:.5rem 0}.agenda-card small{color:#008c86}.registration-section{background:#00a98f;padding:6rem 0}.registration-wrap{max-width:820px}.registration-heading{color:white;margin-bottom:2rem}.registration-heading .section-kicker{color:#d7fff6}.registration-heading h2{font-size:clamp(2rem,4vw,3.5rem)}.registration-heading p{line-height:1.6;max-width:600px}.medmind-form,#medmind-success{background:#fff;padding:2rem;border-radius:22px;border:1px solid #dce9e6}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.medmind-form label{display:grid;gap:.45rem;color:#344440;font-size:.8rem;font-weight:600;margin-bottom:1rem}.medmind-form input{height:46px;border:1px solid #cbdcd8;border-radius:10px;padding:0 .8rem;font:inherit}.medmind-form button{width:100%;border:0;border-radius:999px;background:#172c2a;color:#fff;padding:.95rem;font:inherit;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:.3rem}.medmind-form button:disabled{opacity:.6}.form-status{color:#c03434;font-size:.85rem;margin:.8rem 0 0}.medmind-footer{background:#102422;color:#d9e7e4;padding:2rem 0}.medmind-footer .medmind-wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap}.medmind-footer img{filter:brightness(0) invert(1)}.medmind-footer p,.medmind-footer a{font-size:.8rem;color:#b8cbc7}.medmind-footer a{text-decoration:none}@media(max-width:760px){.medmind-detail{padding-top:64px}.medmind-nav nav{display:none}.medmind-nav{height:64px}.nav-cta{font-size:.75rem;padding:.6rem .8rem}.medmind-hero{padding:4rem 0 3rem}.hero-content{grid-template-columns:1fr;gap:2rem}.hero-art{min-height:300px;order:-1}.speakers-list,.agenda-grid,.form-grid{grid-template-columns:1fr}.medmind-section,.registration-section{padding:4rem 0}.speaker-photo{width:82px;height:82px;flex-basis:82px}.countdown-banner{padding:1.35rem 0}.countdown-banner p{font-size:1rem}.countdown-values b{font-size:1.65rem}}
</style>
